# CSV uploads are processed in memory; summaries are saved and emailed.
# Copy to .env; keep your real credentials out of Git. Email setup is in docs/email-setup.md.

APP_URL=http://localhost:8000 # Use the CSV form’s exact origin so browser submissions pass the origin check.
HOST=127.0.0.1 # Network address for Flask or Waitress; loopback restricts access to this computer.
PORT=8000 # Serving port for the CSV form. Update APP_URL if you change the public address.
DB_PATH=.data/app.sqlite # SQLite file for summary results and outgoing email status.
ADMIN_PASSWORD= # Choose a random password, minimum 16 characters, for the admin summary-history view.
APP_ENV=development # --production sets this to production and disables local email log mode.
MAIL_MODE=sandbox # Capture CSV summaries; production sends email, log writes development previews.
MAIL_FROM=sender@example.com # Sender on CSV summaries; live sending needs your verified domain.
MAILTRAP_PRODUCTION_TOKEN= # Your transactional sending token for real CSV summaries; unused in sandbox.
MAILTRAP_SANDBOX_TOKEN= # API credential allowed to capture csv.summary messages in your test inbox.
MAILTRAP_INBOX_ID= # Numeric inbox identifier from the Sandbox API integration tab.
